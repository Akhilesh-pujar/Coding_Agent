OLLAMA_BASE_URL=http://localhost:11434
APEX_HOST=127.0.0.1
APEX_PORT=8000
APEX_API_KEY=change-this-key
APEX_DEFAULT_MODEL=apex-fast:latest
APEX_PRO_MODEL=apex-pro:latest
APEX_FAST_MODEL=apex-fast:latest
APEX_REQUEST_TIMEOUT=300
APEX_LOG_LEVEL=INFO
# Database: Use PostgreSQL (recommended with pgAdmin) or SQLite
# PostgreSQL: postgresql+asyncpg://<username>:<password>@<host>:5432/<database_name>
APEX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apex_db
# SQLite fallback:
# APEX_DATABASE_URL=sqlite+aiosqlite:///./apex.db
JWT_SECRET_KEY=apex-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

